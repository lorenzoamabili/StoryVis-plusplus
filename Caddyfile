{
    # Global options
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    # Frontend — proxy to nginx container
    reverse_proxy frontend:80

    # Backend API — proxy to backend container
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:4000
    }

    # Security headers (supplements nginx)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Permitted-Cross-Domain-Policies "none"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self';"
    }

    # Access logs
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
