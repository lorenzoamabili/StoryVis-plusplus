{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    // "baseUrl": "./",
    "module": "esnext",
    "types": [
      "node"
    ]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": false
  },
  "exclude": [
    "test.ts",
    "environments/environment.prod.ts",
    "**/*.spec.ts",
    "node_modules/**/*",
    "app/pages/shared/**/*",
    "app/pages/tool/intro-explo/**/*",
    "app/pages/tool/intro-prac/**/*",
    "app/pages/tool/practice/**/*"
  ]
}